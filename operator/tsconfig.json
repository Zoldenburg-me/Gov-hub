{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true,

    // Concorde is not on the npm registry yet; we typecheck against the
    // vendored source (scripts/setup-vendor.sh) and deploy by building it
    // inside the gateway image.
    "paths": {
      "@shutter-network/concorde/*": ["../vendor/concorde/src/*/index.ts"]
    }
  },
  "include": ["main.ts", "drizzle.config.ts", "schema.ts", "src"]
}
