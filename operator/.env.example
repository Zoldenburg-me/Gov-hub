# Model key for the agent's runs.
ANTHROPIC_API_KEY=

# name:password pairs for the delegates this deployment serves.
DELEGATES=alice:change-me,bob:change-me-too

# Ed25519 private key (PEM) the agent's Decisions are signed with.
# Generate one:  openssl genpkey -algorithm ed25519 -out signing-key.pem
SIGNING_KEY_FILE=./signing-key.pem

# Optional overrides.
# SNAPSHOT_SPACE=shutterdao0x36.eth
# DIGEST_CRON=0 9 * * *
# SHUTTER_API_BASE=https://shutter-api.shutter.network/api
